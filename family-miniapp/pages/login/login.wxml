<view class="container">
  <view class="card">
    <view class="card-title">登录</view>
    <view class="card-content">
      <input class="input" placeholder="手机号" bindinput="onPhoneInput" />
      <input class="input" placeholder="密码" type="password" bindinput="onPasswordInput" />
      <button class="btn-primary mt-20" bindtap="login">登录</button>
    </view>
  </view>
</view>
