# 银发守护 - 环境变量配置

# 数据库
DATABASE_URL=sqlite:///./elderguard.db

# JWT 密钥
SECRET_KEY=your-secret-key-change-in-production

# 阿里云 AccessKey
ALCLOUD_ACCESS_KEY_ID=your-access-key-id
ALCLOUD_ACCESS_KEY_SECRET=your-access-key-secret

# 阿里云语音识别
ALCLOUD_APP_KEY_ASR=your-asr-app-key

# 阿里云语音合成
ALCLOUD_APP_KEY_TTS=your-tts-app-key

# 阿里云短信服务
ALCLOUD_SMS_ACCESS_KEY=your-sms-access-key
ALCLOUD_SMS_ACCESS_SECRET=your-sms-access-secret
ALCLOUD_SMS_SIGN_NAME=your-sign-name
ALCLOUD_SMS_TEMPLATE_CODE=your-template-code

# 通义千问
QWEN_API_KEY=your-qwen-api-key
QWEN_MODEL=qwen-turbo
